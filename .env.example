# Neon Postgres connection string. Leave unset locally to use the embedded
# PGlite database in ./.pglite instead.
DATABASE_URL=
# Google Gemini API key and model name (used only for explanations).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Shared password for the whole site (stop-gap until real sign-in).
# Leave empty locally to keep the site open.
APP_PASSWORD=
# Zoho Inventory (optional): reads open purchase orders. Leave empty to upload
# open_purchase_orders.csv instead. ZOHO_DC is the data centre: in, com, eu, com.au...
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
ZOHO_DC=in
