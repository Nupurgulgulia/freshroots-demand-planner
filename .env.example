# Neon Postgres connection string. Leave unset locally to use the embedded
# PGlite database in ./.pglite instead.
DATABASE_URL=
# Google Gemini API key and model name (used only for explanations).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Signs the login cookie (Auth.js). Generate with: npx auth secret  (or any 32+ random bytes).
AUTH_SECRET=
# Optional text shown on the login page (e.g. demo accounts for reviewers). Leave empty to hide.
LOGIN_HINT=
# Used only by `npm run invite`; set it in your shell for that one command, don't keep it here.
# INVITE_PASSWORD=
# Zoho Inventory (optional): reads open purchase orders. Leave empty to upload
# open_purchase_orders.csv instead. ZOHO_DC is the data centre: in, com, eu, com.au...
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
ZOHO_DC=in
