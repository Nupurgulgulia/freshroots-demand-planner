# Neon Postgres connection string. Leave unset locally to use the embedded
# PGlite database in ./.pglite instead.
DATABASE_URL=
# Google Gemini API key and model name (used only for explanations).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Most Gemini calls allowed per calendar month (IST). AI generation pauses when reached. Default 500.
AI_MONTHLY_CALL_CAP=
# Signs the login cookie (Auth.js). Generate with: npx auth secret  (or any 32+ random bytes).
AUTH_SECRET=
# Optional text shown on the login page (e.g. demo accounts for reviewers). Leave empty to hide.
LOGIN_HINT=
# Used only by `npm run invite`; set it in your shell for that one command, don't keep it here.
# INVITE_PASSWORD=
# Zoho Inventory (optional): reads open purchase orders. Leave empty to upload
# open_purchase_orders.csv instead. ZOHO_DC is the data centre: in, com, eu, com.au...
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
ZOHO_DC=in
# Creating DRAFT purchase orders in Zoho from Approved orders (procurement only). Off unless 1.
# Extra scopes: ZohoInventory.purchaseorders.CREATE, ZohoInventory.items.READ, ZohoInventory.contacts.READ.
ZOHO_ORDERING_ENABLED=
# Local testing only: point at the mock server from `npm run mock:zoho` (e.g. http://127.0.0.1:4010).
# Never set these on the live site.
ZOHO_API_BASE=
ZOHO_ACCOUNTS_BASE=
# Scheduled job (Vercel Cron, /api/cron/daily). Vercel sends "Authorization: Bearer <CRON_SECRET>";
# calls without it get 401. Generate a long random value, e.g. `openssl rand -hex 32`.
CRON_SECRET=
# Emails via Resend (optional). Without a key, emails are only logged (Settings > Automation).
RESEND_API_KEY=
# Sender address; onboarding@resend.dev works for testing until your own domain is verified.
EMAIL_FROM=
# Link used in emails. Defaults to the Vercel production URL, then http://localhost:3000.
APP_URL=
# Freshness limits: skip the run if sales lag more than this many complete weeks (default 1)
# or stock is older than this many days (default 10).
STALE_SALES_WEEKS=
STALE_STOCK_DAYS=
